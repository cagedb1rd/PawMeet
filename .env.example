# Server-only Qwen (Alibaba Cloud Model Studio). No model/provider fallback.
DASHSCOPE_API_KEY=
AI_MODEL=qwen3.8-flash
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_ENABLED=false
AI_MAX_DAILY_CALLS=200
AI_MAX_DAILY_TOKENS=300000
DEMO_SESSION_SECRET=
QUOTA_STORE_PATH=.runtime/ai-quota.json
APP_ORIGIN=
# Phase 3: JS key is public; security code stays on the Node server.
# APP_ORIGIN must equal the browser origin, e.g. http://localhost:3103
NEXT_PUBLIC_AMAP_JS_KEY=
AMAP_SECURITY_JSCODE=
