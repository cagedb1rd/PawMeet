# Server-only Qwen (Alibaba Cloud Model Studio). No model/provider fallback.
DASHSCOPE_API_KEY=
# Server-only Google Gemini key (AI Studio), used only when AI_MODEL is a gemini-* model.
GEMINI_API_KEY=
# Whitelisted only (see AGENTS): text qwen3.8-flash | qwen3.8-max-0902 | qwen3.8-27b |
# gemini-3.5-flash-lite | gemini-3.8-flash;
# vision qwen3.8-omni-flash | qwen3.5-omni-plus | gemini-3.5-flash-lite | gemini-3.8-flash.
# Anything else is rejected; Gemini vision also needs GEMINI_API_KEY.
AI_MODEL=qwen3.8-flash
AI_VISION_MODEL=qwen3.8-omni-flash
# Streaming upstream (qwen3.5-omni-plus always streams); timeouts per attempt in ms.
AI_STREAM=true
AI_FIRST_BYTE_TIMEOUT_MS=15000
AI_TOTAL_TIMEOUT_MS=40000
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_ENABLED=false
AI_MAX_DAILY_CALLS=200
AI_MAX_DAILY_TOKENS=300000
DEMO_SESSION_SECRET=
QUOTA_STORE_PATH=.runtime/ai-quota.json
APP_ORIGIN=
# Phase 3: JS key is public; security code stays on the Node server.
# APP_ORIGIN must equal the browser origin, e.g. http://localhost:3103
NEXT_PUBLIC_AMAP_JS_KEY=
AMAP_SECURITY_JSCODE=
